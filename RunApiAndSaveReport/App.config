<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    
    <appSettings>
        <!-- הגדרות API -->
        <add key="ApiBaseUrl" value="https://localhost:49629/api/reports" />
        <add key="ApiTimeout" value="300" /><!-- 5 דקות -->
        
        <!-- הגדרות שמירה -->
        <add key="DefaultOutputFolder" value="C:\Temp" />
        <add key="CreateFolderIfNotExists" value="true" />
        
        <!-- הגדרות כלליות -->
        <add key="ShowDetailedErrors" value="true" />
        <add key="LogToConsole" value="true" />
    </appSettings>
</configuration>